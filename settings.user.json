{
  "permissions": {
    "allow": [
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo view *)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(git remote get-url *)",
      "Bash(git log *)",
      "Bash(git describe *)",
      "Bash(git ls-remote *)",
      "Bash(git worktree list *)",
      "Bash(git branch --list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Bash(npm *)",
      "Bash(pip *)"
    ]
  }
}
