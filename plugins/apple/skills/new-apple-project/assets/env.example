# Apple credentials — másold `.env`-be és töltsd ki. A `.env` gitignore-olt;
# EZT a fájlt (.env.example, placeholderekkel) commitold (enviroment.md).

# Developer Team ID (10 char) — signing → DEVELOPMENT_TEAM
APPLE_TEAM_ID=

# App Store Connect API — CSAK headless/CI feltöltéshez (notarytool / altool / Fastlane)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# A .p8 privkulcs fájlként (AuthKey_<KEYID>.p8), NEM ide — gitignore-olva (*.p8).
# Opcionálisan az útvonala:
# APPLE_API_KEY_PATH=
